# ============================================================
# Altera - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# Public frontend variables
# These are exposed to the browser. Do not put secrets here.
# Required for local development.
# ------------------------------------------------------------

# Sepolia RPC endpoint (required for all testnet DeFi features)
# Get one at https://infura.io or https://alchemy.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Base Mainnet RPC endpoint (required for Genesis Pass NFT minting)
# Get one at https://infura.io or https://alchemy.com
NEXT_PUBLIC_BASE_RPC_URL=

# WalletConnect project ID (required for WalletConnect wallet support)
# Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ------------------------------------------------------------
# Private deploy and script variables
# Server-side only. Never expose these to the browser.
# Required only for contract deployment and interaction scripts.
# ------------------------------------------------------------

# Private key of the deployer wallet (used by scripts/ and hardhat.config.js)
# Never commit a real private key. Use a dedicated testnet wallet.
DEPLOYER_PRIVATE_KEY=

# RPC endpoint for Hardhat deployment scripts targeting Sepolia
# Can be the same value as NEXT_PUBLIC_SEPOLIA_RPC_URL
SEPOLIA_RPC_URL=

# RPC endpoint for Hardhat deployment scripts targeting Base Mainnet
BASE_MAINNET_RPC_URL=

# ------------------------------------------------------------
# Contract verification (optional, for verifying on block explorers)
# ------------------------------------------------------------

# Etherscan API key for contract verification on Sepolia
ETHERSCAN_API_KEY=

# Basescan API key for contract verification on Base
BASESCAN_API_KEY=
